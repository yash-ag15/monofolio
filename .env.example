# Site owner only. Copy to .env.local and add YOUR xAI key — visitors never enter a key.
# The key stays on the server (server/grok-proxy.js) and is never sent to the browser.
XAI_API_KEY=

# Optional
# XAI_MODEL=grok-4              # model used for text (brief, ATS review)
# XAI_VISION_MODEL=grok-4       # model used for images (Inspire)
# GROK_RATE_PER_MINUTE=6        # per visitor IP, protects your credits
# GROK_RATE_PER_DAY=60
# PORT=3000                     # for `npm start`
