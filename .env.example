# Site owner only. Copy to .env.local and add YOUR xAI key — visitors never enter a key.
# The key stays on the server (server/grok-proxy.js) and is never sent to the browser.
XAI_API_KEY=

# Optional
# XAI_MODEL=grok-4              # model used for text (brief, ATS review)
# XAI_VISION_MODEL=grok-4       # model used for images (Inspire)
# GROK_RATE_PER_MINUTE=6        # per visitor IP, protects your credits
# GROK_RATE_PER_DAY=60
# PORT=3000                     # for `npm start`

# ---------- Database (Neon Postgres) ----------
# Paste your Neon connection string here (Neon dashboard → your project → Connect → copy the URL).
# It contains your database password — keep it only in .env.local, never commit or share it.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# ---------- Accounts ----------
# Without DATABASE_URL, accounts and saved data are stored as JSON files here. Keep it out of git and back it up.
# DATA_DIR=./data
# Secret used to sign login cookies. Generated automatically into DATA_DIR if empty;
# set it explicitly in production (any long random string).
# AUTH_SECRET=

# Google sign-in (optional). Create an OAuth client at https://console.cloud.google.com/apis/credentials
#   Application type: Web application
#   Authorised redirect URIs: http://localhost:5173/api/auth/google/callback   (dev)
#                             https://YOUR-DOMAIN/api/auth/google/callback      (production)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APP_URL=https://YOUR-DOMAIN      # production only, used to build the redirect URI

# Demo: "Try the demo" on the sign-in page, and a demo login. Each demo sign-in gets its own
# temporary copy of the sample data, deleted after 24 hours. Set DEMO_ENABLED=false to turn it off.
# DEMO_ENABLED=true
# DEMO_EMAIL=demo@monofolio.app
# DEMO_PASSWORD=demo1234
