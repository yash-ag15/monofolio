# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Everything here is read on the server only — visitors never see or enter any key.

# ---------- AI (required for AI features) ----------
# One key powers every AI feature: portfolio builder, ATS review, tailoring suggestions, cover letters.
# Groq (free tier available): https://console.groq.com/keys  → keys start with gsk_
# xAI Grok:                   https://console.x.ai           → keys start with xai-
# The provider is picked automatically from the key.
AI_API_KEY=

# Optional AI settings
# AI_MODEL=openai/gpt-oss-120b         # text model   (default: openai/gpt-oss-120b on Groq, grok-4 on xAI)
# AI_VISION_MODEL=qwen/qwen3.8-27b     # image model  (default: qwen/qwen3.8-27b on Groq, same as AI_MODEL on xAI)
# AI_BASE_URL=                         # any OpenAI-compatible endpoint
# AI_RATE_PER_MINUTE=6                 # AI requests per visitor (IP) — protects your credits
# AI_RATE_PER_DAY=60

# ---------- Database (Neon Postgres) ----------
# Accounts and each user's saved work. Neon has a free tier: https://neon.tech
# Dashboard → your project → Connect → copy the connection string (keep ?sslmode=require).
# Tables are created automatically on first start.
# Leave empty for local development: data is then stored as JSON files in ./data instead.
DATABASE_URL=

# ---------- Accounts ----------
# Signs the login cookie. Required in production (any long random string), e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If empty, one is generated into ./data/.secret (fine for local development).
AUTH_SECRET=

# Where JSON-file storage lives when DATABASE_URL is empty.
# DATA_DIR=./data

# ---------- Google sign-in (optional) ----------
# Create an OAuth client: https://console.cloud.google.com/apis/credentials → Web application
#   Authorised JavaScript origins: http://localhost:5173            and https://YOUR-DOMAIN
#   Authorised redirect URIs:      http://localhost:5173/api/auth/google/callback
#                                  https://YOUR-DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Your public URL in production (used to build the Google redirect URI).
# APP_URL=https://YOUR-DOMAIN
